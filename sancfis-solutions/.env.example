# Variables à configurer dans l'hébergeur ou le shell. Ce fichier n'est pas chargé automatiquement.
HOST=127.0.0.1
PORT=3080
NODE_ENV=production
PUBLIC_ORIGIN=https://REMPLACER-PAR-LE-DOMAINE-INTERNE
USERS_FILE=config/users.json
DATA_DIR=data
# Un seul processus Node par volume de données. TLS via reverse proxy en production.
AI_ENABLED=false
# Ne jamais placer une vraie clé dans ce fichier ou dans le navigateur.
MISTRAL_API_KEY=
MISTRAL_MODEL=
AI_DAILY_MAX_CALLS=10
